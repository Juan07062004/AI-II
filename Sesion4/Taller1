import cv2
import numpy as np
import matplotlib.pyplot as plt

# 1. Cargar imagen base o generar una sintética con degradado
ruta = 'imagen_base.jpg'
imagen = cv2.imread(ruta, cv2.IMREAD_GRAYSCALE)

if imagen is None:
    # Imagen sintética 300x300 con un cuadro central definido
    imagen = np.full((300, 300), 50, dtype=np.uint8)
    imagen[80:220, 80:220] = 200

# Añadir ruido impulsivo severo (Sal y Pimienta)
np.random.seed(42)
probabilidad_ruido = 0.08
imagen_ruidosa = np.copy(imagen)

# Ruido de Sal (píxeles blancos = 255)
mascara_sal = np.random.rand(*imagen.shape) < (probabilidad_ruido / 2)
imagen_ruidosa[mascara_sal] = 255

# Ruido de Pimienta (píxeles negros = 0)
mascara_pimienta = np.random.rand(*imagen.shape) < (probabilidad_ruido / 2)
imagen_ruidosa[mascara_pimienta] = 0

# 2. Aplicar los tres filtros con un kernel agresivo de 7x7
ksize = 7

# Filtro 1: Media (Box Filter / Promedio simple)
blur_media = cv2.blur(imagen_ruidosa, (ksize, ksize))

# Filtro 2: Gaussiano (Pesos decrecientes según campana de Gauss)
blur_gauss = cv2.GaussianBlur(imagen_ruidosa, (ksize, ksize), 0)

# Filtro 3: Mediana (Filtro no lineal por ordenamiento de rango)
blur_mediana = cv2.medianBlur(imagen_ruidosa, ksize)

# 3. Mostrar comparativa visual
fig, axes = plt.subplots(1, 4, figsize=(18, 5))

axes[0].imshow(imagen_ruidosa, cmap='gray')
axes[0].set_title("1. Con Ruido Sal y Pimienta", fontweight='bold')
axes[0].axis('off')

axes[1].imshow(blur_media, cmap='gray')
axes[1].set_title(f"2. Filtro Media ({ksize}x{ksize})\nManchas Grises", fontweight='bold')
axes[1].axis('off')

axes[2].imshow(blur_gauss, cmap='gray')
axes[2].set_title(f"3. Filtro Gaussiano ({ksize}x{ksize})\nPreserva Picos", fontweight='bold')
axes[2].axis('off')

axes[3].imshow(blur_mediana, cmap='gray')
axes[3].set_title(f"4. Filtro Mediana ({ksize}x{ksize})\nLimpieza Perfecta", fontweight='bold')
axes[3].axis('off')

plt.tight_layout()
plt.show()


