import numpy as np
from sklearn.neighbors import KNeighborsClassifier

# 1, 2 y 3. Dataset extendido con 10 clientes y 3 dimensiones:
# Características: [Edad, Salario (en miles), Número de Hijos]
X_entrenamiento = np.array([
    [20, 30, 0],  # 0: NO COMPRA
    [40, 50, 2],  # 1: COMPRA
    [35, 45, 1],  # 1: COMPRA
    [22, 28, 0],  # 0: NO COMPRA
    [50, 80, 3],  # 1: COMPRA
    [25, 32, 1],  # 0: NO COMPRA
    [45, 65, 2],  # 1: COMPRA
    [19, 20, 0],  # 0: NO COMPRA
    [55, 90, 1],  # 1: COMPRA
    [32, 42, 2]   # 1: COMPRA
])

# Etiquetas: 0 = NO COMPRA, 1 = COMPRA
Y_entrenamiento = np.array([0, 1, 1, 0, 1, 0, 1, 0, 1, 1])

# Nuevo cliente de prueba: [Edad=26, Salario=35, Hijos=1]
nuevo_cliente = np.array([[26, 35, 1]])

# 4. Experimentación variando el hiperparámetro K
# Modelo con K = 1
knn_k1 = KNeighborsClassifier(n_neighbors=1)
knn_k1.fit(X_entrenamiento, Y_entrenamiento)
pred_k1 = knn_k1.predict(nuevo_cliente)

# Modelo con K = 5
knn_k5 = KNeighborsClassifier(n_neighbors=5)
knn_k5.fit(X_entrenamiento, Y_entrenamiento)
pred_k5 = knn_k5.predict(nuevo_cliente)

mapeo_clases = {0: "NO COMPRA", 1: "COMPRA"}

print("=" * 50)
print(f"Predicción con K = 1: {pred_k1[0]} ({mapeo_clases[pred_k1[0]]})")
print(f"Predicción con K = 5: {pred_k5[0]} ({mapeo_clases[pred_k5[0]]})")
print("=" * 50)
