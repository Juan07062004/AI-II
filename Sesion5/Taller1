TALLER DE LABORATORIO
import cv2
import numpy as np
import matplotlib.pyplot as plt

# 1. Cargar imagen en escala de grises
ruta = 'carretera.jpg'
imagen = cv2.imread(ruta, cv2.IMREAD_GRAYSCALE)

if imagen is None:
    # Generar imagen sintética de prueba si no existe el archivo local
    imagen = np.zeros((300, 300), dtype=np.uint8)
    # Formas geométricas: rectángulo y líneas
    imagen[50:250, 50:150] = 255
    cv2.circle(imagen, (220, 150), 50, 255, -1)

# 2. Generación de las tres variables
# Bordes verticales (Sobel X) usando formato de 64 bits flotante para capturar derivadas negativas
sobel_x = cv2.Sobel(imagen, cv2.CV_64F, 1, 0, ksize=3)
sobel_x_abs = cv2.convertScaleAbs(sobel_x)

# Bordes horizontales (Sobel Y)
sobel_y = cv2.Sobel(imagen, cv2.CV_64F, 0, 1, ksize=3)
sobel_y_abs = cv2.convertScaleAbs(sobel_y)

# Bordes combinados y afinados con Algoritmo de Canny
# Umbral inferior: 50, Umbral superior: 150
bordes_canny = cv2.Canny(imagen, 50, 150)

# 3. Panel de visualización comparativa
plt.figure(figsize=(14, 8))

plt.subplot(2, 2, 1)
plt.imshow(imagen, cmap='gray')
plt.title("1. Imagen Original en Escala de Grises", fontweight='bold')
plt.axis('off')

plt.subplot(2, 2, 2)
plt.imshow(sobel_x_abs, cmap='gray')
plt.title("2. Sobel X (Bordes Verticales)", fontweight='bold')
plt.axis('off')

plt.subplot(2, 2, 3)
plt.imshow(sobel_y_abs, cmap='gray')
plt.title("3. Sobel Y (Bordes Horizontales)", fontweight='bold')
plt.axis('off')

plt.subplot(2, 2, 4)
plt.imshow(bordes_canny, cmap='gray')
plt.title("4. Algoritmo Canny (Bordes Afinados a 1px)", fontweight='bold')
plt.axis('off')

plt.tight_layout()
plt.show()

